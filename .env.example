# Copy to .env and adjust: cp .env.example .env

POSTGRES_USER=notes
POSTGRES_PASSWORD=change-me
POSTGRES_DB=notes

# ":80" = plain HTTP on any hostname (local testing, or a bare IP).
# On the server use a domain pointing at it, e.g. notes.example.com, or
# <server-ip>.sslip.io, and Caddy will get an HTTPS certificate automatically.
SITE_ADDRESS=:80
